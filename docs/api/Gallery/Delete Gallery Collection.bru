meta {
  name: Delete Gallery Collection
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/gallery/collection/:collection
  body: json
  auth: bearer
}

params:path {
  collection: taiwan roadtrip 2024
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "path": "taiwan roadtrip 2024",
    "title": "Taiwan Roadtrip @ 2024"
  }
}
