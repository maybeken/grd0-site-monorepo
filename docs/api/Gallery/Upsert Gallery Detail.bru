meta {
  name: Upsert Gallery Detail
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/gallery/details/:path
  body: json
  auth: bearer
}

params:path {
  path: /gallery/new zealand
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "filename": "DSC01000.jpg",
    "tz_adjustment": 5,
    "description": "Night sky in Lake Tekapo taken with long exposure, showing the stars among the milky way."
  }
}
