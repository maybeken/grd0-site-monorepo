    "rehype-external-links": "^3.0.0",
    "rehype-plugin-image-native-lazy-loading": "^1.2.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-breaks": "^4.0.0",
