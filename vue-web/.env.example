VITE_DEFAULT_TITLE=IDEA GROUND ZERO
# Asset origins must be absolute https URLs: the cutout tool's model host is
# derived from this value, and protocol-relative URLs break the runtime's
# file-metadata probe.
VITE_ASSETS_URL=https://assets.grd0.net
VITE_API_URL=//api.grd0.net/api
# Self-hosted background-removal model repository for the Grand Tour cutout tool.
# The repository must expose config.json, preprocessor_config.json and onnx/model_quantized.onnx beneath this host.
VITE_CUTOUT_MODEL_HOST=https://assets.grd0.net/models/
VITE_CUTOUT_MODEL_ID=ormbg
# Self-hosted ONNX Runtime wasm backend (asyncify and plain variants).
VITE_CUTOUT_RUNTIME_HOST=https://assets.grd0.net/onnxruntime/
# Development only: bypass frontend auth. `pnpm dev` already enables this.
# VITE_APP_ENV=LOCAL
